<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- AppBar overlay styles -->
    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>
    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>

    <!-- General styles -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Layout specific styles -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1px</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- Dialog styles -->
    <style name="FilePickerAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Material Button Styles -->
    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/button_text_primary</item>
        <item name="backgroundTint">@color/button_background_primary</item>
        <item name="android:minHeight">@dimen/button_height_min</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_horizontal</item>
    </style>

    <style name="Widget.App.Button.Primary.Pink" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/button_background_primary_pink</item>
    </style>

    <style name="Widget.App.Button.Primary.Eink" parent="Widget.App.Button.Primary">
        <item name="backgroundTint">@color/button_background_primary_eink</item>
        <item name="strokeColor">@color/color_eink_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/button_text_secondary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="strokeColor">@color/button_stroke_secondary</item>
        <item name="android:minHeight">@dimen/button_height_min</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_horizontal</item>
    </style>

    <style name="Widget.App.Button.Secondary.Pink" parent="Widget.App.Button.Secondary">
        <item name="strokeColor">@color/button_stroke_secondary_pink</item>
    </style>

    <style name="Widget.App.Button.Secondary.Eink" parent="Widget.App.Button.Secondary">
        <item name="strokeColor">@color/button_stroke_secondary_eink</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/button_text_secondary</item>
        <item name="android:minHeight">@dimen/button_height_min</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_horizontal</item>
    </style>

    <style name="Widget.App.Button.Text.Pink" parent="Widget.App.Button.Text">
        <item name="android:textColor">@color/color_pink_primary</item>
    </style>

    <style name="Widget.App.Button.Text.Eink" parent="Widget.App.Button.Text">
        <item name="android:textColor">@color/color_eink_primary</item>
    </style>

    <!-- Material CardView Styles -->
    <style name="Widget.App.CardView" parent="android:Widget">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardUseCompatPadding">true</item>
        <item name="contentPadding">@dimen/padding_card</item>
    </style>

    <style name="Widget.App.CardView.Clickable" parent="android:Widget">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Widget.App.CardView.Eink" parent="android:Widget">
        <item name="cardCornerRadius">0dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/color_eink_outline</item>
        <item name="strokeWidth">@dimen/eink_border_width</item>
    </style>

    <!-- TextInputLayout Styles -->
    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/text_secondary_light</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="boxStrokeColor">@color/color_outline</item>
        <item name="boxBackgroundColor">@color/color_surface</item>
    </style>

    <style name="Widget.App.TextInputLayout.Pink" parent="Widget.App.TextInputLayout">
        <item name="android:textColorHint">@color/text_secondary_pink</item>
        <item name="android:textColor">@color/text_primary_pink</item>
    </style>

    <style name="Widget.App.TextInputLayout.Eink" parent="Widget.App.TextInputLayout">
        <item name="android:textColorHint">@color/text_secondary_eink</item>
        <item name="android:textColor">@color/text_primary_eink</item>
        <item name="android:background">@drawable/edit_text_background_eink</item>
    </style>

    <!-- Toolbar Styles -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="android:background">@color/color_surface</item>
        <item name="titleTextColor">@color/text_primary_light</item>
        <item name="subtitleTextColor">@color/text_secondary_light</item>
    </style>

    <style name="Widget.App.Toolbar.Pink" parent="Widget.App.Toolbar">
        <item name="android:background">@color/color_pink_surface</item>
        <item name="titleTextColor">@color/text_primary_pink</item>
        <item name="subtitleTextColor">@color/text_secondary_pink</item>
    </style>

    <style name="Widget.App.Toolbar.Eink" parent="Widget.App.Toolbar">
        <item name="android:background">@color/color_eink_surface</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextColor">@color/text_primary_eink</item>
        <item name="subtitleTextColor">@color/text_secondary_eink</item>
    </style>

    <!-- TextView Styles -->
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.App.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_secondary_light</item>
        <item name="android:textSize">@dimen/text_size_subtitle</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary_light</item>
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>

    <!-- List Item Styles -->
    <style name="Widget.App.ListItem" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/list_item_height</item>
        <item name="android:padding">@dimen/list_item_padding</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.App.ListItem.Eink" parent="android:Widget">
        <item name="android:background">@color/color_eink_surface</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <!-- Divider Styles -->
    <style name="Widget.App.Divider" parent="android:Widget">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
        <item name="android:layout_marginTop">@dimen/spacing_medium</item>
        <item name="android:layout_marginBottom">@dimen/spacing_medium</item>
    </style>

    <style name="Widget.App.Divider.Vertical" parent="android:Widget">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <!-- Progress Indicator Styles -->
    <style name="Widget.App.ProgressBar" parent="Widget.AppCompat.ProgressBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/progress_bar_height</item>
        <item name="android:indeterminateTint">@color/color_primary</item>
    </style>

    <style name="Widget.App.ProgressBar.Circular" parent="Widget.AppCompat.ProgressBar">
        <item name="android:layout_width">@dimen/circular_progress_size</item>
        <item name="android:layout_height">@dimen/circular_progress_size</item>
        <item name="android:indeterminateTint">@color/color_primary</item>
    </style>

    <!-- FloatingActionButton Styles -->
    <style name="Widget.App.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:layout_width">@dimen/fab_size</item>
        <item name="android:layout_height">@dimen/fab_size</item>
        <item name="android:layout_margin">@dimen/fab_margin</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="tint">@color/color_on_primary</item>
    </style>

    <style name="Widget.App.FloatingActionButton.Mini">
        <item name="android:layout_width">@dimen/fab_size_mini</item>
        <item name="android:layout_height">@dimen/fab_size_mini</item>
    </style>

    <!-- Bottom Navigation Styles -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Design.BottomNavigationView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/bottom_nav_height</item>
        <item name="itemBackground">@color/color_surface</item>
        <item name="itemIconTint">@color/bottom_panel_icon</item>
        <item name="itemTextColor">@color/text_secondary_light</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Tab Layout Styles -->
    <style name="Widget.App.TabLayout" parent="Widget.Design.TabLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/tab_height</item>
        <item name="tabIndicatorColor">@color/color_primary</item>
        <item name="tabIndicatorHeight">@dimen/tab_indicator_height</item>
        <item name="tabSelectedTextColor">@color/color_primary</item>
        <item name="tabTextColor">@color/text_secondary_light</item>
    </style>

    <!-- Switch Styles -->
    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:thumbTint">@color/color_primary</item>
        <item name="android:trackTint">@color/color_primary_container</item>
    </style>

    <!-- Checkbox Styles -->
    <style name="Widget.App.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/color_primary</item>
    </style>

    <!-- RadioButton Styles -->
    <style name="Widget.App.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/color_primary</item>
    </style>

    <!-- Dialog Styles -->
    <style name="Widget.App.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@color/color_surface</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>

    <!-- E-ink Theme Base Style -->
    <style name="EinkTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_eink_primary</item>
        <item name="colorPrimaryDark">@color/color_eink_primary</item>
        <item name="colorAccent">@color/color_eink_primary</item>
        <item name="android:colorBackground">@color/color_eink_background</item>
        <item name="android:textColorPrimary">@color/color_eink_on_background</item>
        <item name="android:textColorSecondary">@color/color_eink_secondary</item>
        <item name="android:textColor">@color/color_eink_on_background</item>
        <item name="android:windowBackground">@color/color_eink_background</item>
        <item name="android:statusBarColor">@color/color_eink_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/color_eink_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>