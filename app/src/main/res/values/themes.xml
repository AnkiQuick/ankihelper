<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Primary Material3 theme -->
    <style name="Theme.AnkiHelper" parent="Theme.Material3.Light">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimary</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- Background colors -->
        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorOnBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>

        <!-- Status colors -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@android:color/white</item>

        <!-- Custom popup attributes -->
        <item name="color_popup_background">@color/popup_background</item>
        <item name="color_footer_background">@color/footer_background</item>
        <item name="button_background_selector">@drawable/selector</item>
        <item name="icon_scroll_up">@drawable/ic_up_arrow</item>
        <item name="icon_translate_normal">@drawable/icon_translate_normal</item>
        <item name="icon_left_arrow">@drawable/ic_left_arrow</item>
        <item name="icon_right_arrow">@drawable/ic_right_arrow</item>
        <item name="icon_note">@drawable/ic_note_black</item>
        <item name="icon_tag">@drawable/ic_tag_black</item>
        <item name="icon_play">@drawable/ic_ali_play</item>
        <item name="icon_search">@drawable/ic_search</item>
        <item name="icon_add">@drawable/ic_add_grey</item>
        <item name="icon_add_done">@drawable/ic_ok</item>
        <item name="icon_remove">@drawable/ic_minus</item>
        <item name="icon_edit">@drawable/ic_edit</item>
        <item name="icon_save">@drawable/ic_save</item>
        <item name="icon_discard">@drawable/ic_undo</item>
    </style>

    <!-- Pink theme variant -->
    <style name="Theme.AnkiHelperPink" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/colorPrimaryPink</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryPink</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>

        <item name="colorSecondary">@color/colorAccentPink</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <item name="android:colorBackground">@android:color/white</item>
        <item name="colorOnBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@color/colorPrimaryDarkPink</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkPink</item>

        <!-- Custom popup attributes for pink theme -->
        <item name="color_popup_background">@color/popup_background_pink</item>
        <item name="color_footer_background">@color/footer_background_pink</item>
        <item name="button_background_selector">@drawable/selector_pink</item>
        <item name="icon_scroll_up">@drawable/ic_up_arrow</item>
        <item name="icon_translate_normal">@drawable/icon_translate_normal</item>
        <item name="icon_left_arrow">@drawable/ic_left_arrow</item>
        <item name="icon_right_arrow">@drawable/ic_right_arrow</item>
        <item name="icon_note">@drawable/ic_note_black</item>
        <item name="icon_tag">@drawable/ic_tag_black</item>
        <item name="icon_play">@drawable/ic_ali_play_pink</item>
        <item name="icon_search">@drawable/ic_search</item>
        <item name="icon_add">@drawable/ic_add_blue</item>
        <item name="icon_add_done">@drawable/ic_ok</item>
        <item name="icon_remove">@drawable/ic_minus</item>
        <item name="icon_edit">@drawable/ic_edit</item>
        <item name="icon_save">@drawable/ic_save</item>
        <item name="icon_discard">@drawable/ic_undo</item>

        <!-- CardView support via Material3 theme -->
    </style>

    <!-- Legacy compatibility - maps to Theme.AnkiHelper -->
    <style name="AppTheme" parent="Theme.AnkiHelper" />

    <!-- Legacy pink compatibility - maps to Theme.AnkiHelperPink -->
    <style name="AppThemePink" parent="Theme.AnkiHelperPink" />

    <!-- Transparent Activity theme - properly extended for CardView and all required attributes -->
    <style name="Transparent" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="colorOnBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>

        <!-- Pop-up specific styling -->
        <item name="color_popup_background">@color/popup_background</item>
        <item name="color_footer_background">@color/footer_background</item>
        <item name="button_background_selector">@drawable/selector</item>
        <item name="icon_scroll_up">@drawable/ic_up_arrow</item>
        <item name="icon_translate_normal">@drawable/icon_translate_normal</item>
        <item name="icon_left_arrow">@drawable/ic_left_arrow</item>
        <item name="icon_right_arrow">@drawable/ic_right_arrow</item>
        <item name="icon_note">@drawable/ic_note_black</item>
        <item name="icon_tag">@drawable/ic_tag_black</item>
        <item name="icon_play">@drawable/ic_ali_play</item>
        <item name="icon_search">@drawable/ic_search</item>
        <item name="icon_add">@drawable/ic_add_grey</item>
        <item name="icon_add_done">@drawable/ic_ok</item>
        <item name="icon_remove">@drawable/ic_minus</item>
        <item name="icon_edit">@drawable/ic_edit</item>
        <item name="icon_save">@drawable/ic_save</item>
        <item name="icon_discard">@drawable/ic_undo</item>

        <!-- CardView support and transparent window styling -->
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>

        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="TransparentPink" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimaryPink</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/colorAccentPink</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="colorOnBackground">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@android:color/black</item>

        <!-- Pop-up specific styling for pink theme -->
        <item name="color_popup_background">@color/popup_background_pink</item>
        <item name="color_footer_background">@color/footer_background_pink</item>
        <item name="button_background_selector">@drawable/selector_pink</item>
        <item name="icon_scroll_up">@drawable/ic_up_arrow</item>
        <item name="icon_translate_normal">@drawable/icon_translate_normal</item>
        <item name="icon_left_arrow">@drawable/ic_left_arrow</item>
        <item name="icon_right_arrow">@drawable/ic_right_arrow</item>
        <item name="icon_note">@drawable/ic_note_black</item>
        <item name="icon_tag">@drawable/ic_tag_black</item>
        <item name="icon_play">@drawable/ic_ali_play_pink</item>
        <item name="icon_search">@drawable/ic_search</item>
        <item name="icon_add">@drawable/ic_add_blue</item>
        <item name="icon_add_done">@drawable/ic_ok</item>
        <item name="icon_remove">@drawable/ic_minus</item>
        <item name="icon_edit">@drawable/ic_edit</item>
        <item name="icon_save">@drawable/ic_save</item>
        <item name="icon_discard">@drawable/ic_undo</item>

        <!-- CardView support -->
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>

        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>